[user]
  name = Tim Farnam
  email = twfarnam@gmail.com

[core]
	excludesfile = ~/.gitignore

[alias]
    l = log
    a = add
    c = commit
    ca = commit -a
    cm = commit -m
    cam = commit -a -m
 
    d = diff
    ds = diff --stat
    dc = diff --cached

    s = status
    co = checkout
    cob = checkout -b
[init]
	defaultBranch = main

# Catppuccin Mocha
[color "diff"]
    meta = "#cba6f7" bold
    frag = "#89b4fa" bold
    func = "#7f849c" italic
    old = "#f38ba8"
    new = "#a6e3a1"
    # default fg so tmux's window-style dims it in inactive panes
    context = normal
    commit = "#f9e2af" bold
    whitespace = "#f38ba8" reverse
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
