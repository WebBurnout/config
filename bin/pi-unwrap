#!/usr/bin/env python3
# Undo the hard word-wrapping in a block of terminal text (pi's TUI, mostly)
# so pasted prose is one paragraph per line again. Reads stdin, writes stdout.
#
# Greedy word wrap breaks a line for exactly one reason: the next word did not
# fit. So two lines were wrapped (rather than genuinely separate) if putting the
# first word of the second line back onto the first would have overflowed. The
# wrap column is recovered as the widest line in the input.

import os
import re
import sys
import unicodedata

ANSI = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)|\x1b[@-_]")
GUTTER_CHARS = " \t│┃▏|"
BOX_CHARS = "│┃▏┌└├╭╰─━═┏┗┣|"
BLOCK_START = re.compile(r"(?:[-*+•]\s|\d+[.)]\s|#{1,6}\s|>\s)")


def width(text):
    total = 0
    for char in text:
        if unicodedata.combining(char):
            continue
        total += 2 if unicodedata.east_asian_width(char) in "WF" else 1
    return total


def indent(line):
    return len(line) - len(line.lstrip())


def starts_block(line):
    stripped = line.lstrip()
    if not stripped:
        return True
    if stripped.startswith(("```", "~~~")):
        return True
    return stripped[0] in BOX_CHARS or bool(BLOCK_START.match(stripped))


def strip_gutter(lines):
    body = [line for line in lines if line.strip()]
    if not body:
        return lines
    common = os.path.commonprefix(body)
    end = 0
    while end < len(common) and common[end] in GUTTER_CHARS:
        end += 1
    prefix = common[:end]
    if not prefix:
        return lines
    return [line[len(prefix):] if line.startswith(prefix) else line for line in lines]


def unwrap(lines):
    wrap_column = max((width(line) for line in lines), default=0)
    out = []
    previous = None
    fenced = False
    for line in lines:
        joinable = previous is not None and not fenced and can_join(previous, line, wrap_column)
        if joinable:
            out[-1] += " " + line.strip()
        else:
            out.append(line)
        if line.lstrip().startswith(("```", "~~~")):
            fenced = not fenced
        previous = line
    return out


def can_join(previous, line, wrap_column):
    if not previous.strip() or not line.strip():
        return False
    if starts_block(line) or previous.lstrip()[0] in BOX_CHARS:
        return False
    if indent(line) < indent(previous):
        return False
    first_word = line.split()[0]
    return width(previous) + 1 + width(first_word) > wrap_column


def main():
    lines = ANSI.sub("", sys.stdin.read()).split("\n")
    lines = strip_gutter([line.rstrip() for line in lines])
    sys.stdout.write("\n".join(unwrap(lines)))


main()
