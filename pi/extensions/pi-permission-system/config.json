{
  "yoloMode": true,
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow",
      "*.env.template": "allow"
    },
    "bash": {
      "*": "allow",
      "sudo *": "ask",
      "git checkout *": "deny",
      "git stash *": "deny",
      "git add *": "deny",
      "gcloud *": "ask",
      "tofu *": "ask"
    },
    "external_directory": {
      "*": "ask",
      "/tmp": "allow",
      "/tmp/*": "allow",
      "/private/tmp": "allow",
      "/private/tmp/*": "allow"
    }
  }
}
